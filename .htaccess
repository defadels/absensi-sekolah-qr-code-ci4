# Fallback for cPanel setups where the domain document root points to the
# project directory instead of the recommended public/ directory.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block hidden files/directories, while allowing ACME SSL validation paths.
    RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
    RewriteRule ^\.well-known(?:/|$) - [END]

    # Never expose application or dependency directories from the project root.
    RewriteRule ^(?:app|system|vendor|writable|tests|builds|\.git)(?:/|$) - [F,L,NC]

    # Serve an existing public asset (CSS, JS, images, uploads, etc.) from public/.
    RewriteCond %{REQUEST_URI} !^/public(?:/|$) [NC]
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
    RewriteRule ^(.+)$ public/$1 [END]

    # Do not allow visitors to browse the public/ directory as a URL prefix.
    RewriteRule ^public(?:/|$) - [F,L,NC]

    # Send all other requests to CodeIgniter's front controller.
    RewriteRule ^$ public/index.php [END]
    RewriteRule ^(.+)$ public/index.php/$1 [END,QSA]
</IfModule>

# Protect configuration and project files if the project root is web-accessible.
<FilesMatch "(?i)^(\.env(?:\..*)?|composer\.(?:json|lock)|phpunit\.xml(?:\.dist)?|spark)$">
    Require all denied
</FilesMatch>
